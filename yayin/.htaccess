# TAKDER — Apache (cPanel/Plesk) sunucular için temel ayarlar.
# Sunucunuz Nginx ise bu dosyanın etkisi olmaz, zararı da olmaz.

# --- Karakter kodlaması: Türkçe karakterlerin bozulmaması için ---
AddDefaultCharset UTF-8

# --- Hata sayfaları ---
ErrorDocument 404 /404.html

# --- Bağış sayfası geçici olarak yayında değil ---
# Eski bağlantılar 404 vermesin diye geçici (302) yönlendirme.
# Bağış sayfası geri açıldığında bu blok silinir.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^bagis\.html$ / [R=302,L]
  RewriteRule ^en/donate\.html$ /en/ [R=302,L]
  # Site haritası (Kasım 2026): taşınan sayfalar — kalıcı yönlendirme
  RewriteRule ^kaynaklar\.html$ /toplum-icin.html [R=301,L]
  RewriteRule ^en/resources\.html$ /en/for-the-public.html [R=301,L]
</IfModule>

# --- Sıkıştırma: sayfa daha hızlı açılır ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Tarayıcı önbelleği ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 week"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# --- Güvenlik başlıkları ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Kaynak klasörünün listelenmesini engelle ---
Options -Indexes
